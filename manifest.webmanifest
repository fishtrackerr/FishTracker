{
  "name": "Fish Tracker",
  "short_name": "FishTracker",
  "description": "Offline-first fishing register for sessions, catches, lakes, and weather.",
  "id": "./",
  "lang": "en",
  "orientation": "any",
  "categories": ["sports", "utilities"],
  "theme_color": "#0b0b0b",
  "background_color": "#0b0f14",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "scope": "./",
  "start_url": "./",
  "icons": [
    {
      "src": "icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
