  "screenshots": [
    {
      "src": "screenshots/narrow-sessions.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Track fishing sessions offline"
    },
    {
      "src": "screenshots/narrow-catches.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Log catches with photos and weather"
    },
    {
      "src": "screenshots/narrow-lakes.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Save lakes and spots you return to"
    },
    {
      "src": "screenshots/wide-overview.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "FishTracker overview"
    }
  ],
  "shortcuts": [
    {
      "name": "Active session",
      "short_name": "Session",
      "description": "Open or continue the active fishing session",
      "url": "./sessions/active",
      "icons": [
        {
          "src": "icons/icon-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Lakes",
      "short_name": "Lakes",
