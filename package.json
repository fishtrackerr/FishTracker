{
  "name": "fish-tracker",
  "version": "0.0.56",
  "scripts": {
    "ng": "ng",
    "set-version": "node ./set-version.js",
    "start": "ng serve",
    "prebuild": "npm run icons",
    "build": "ng build",
    "prebuild-prod": "npm run icons",
    "build-prod": "ng build --configuration production",
    "prebuild-android": "npm run icons",
    "build-android": "ng build --configuration android && npx cap sync android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint \"src/**/*.{ts,html}\" --max-warnings 0",
    "icons": "node scripts/generate-pwa-icons.mjs && node scripts/generate-android-icons.mjs",
    "icons:android": "node scripts/generate-android-icons.mjs",
    "store-assets": "node scripts/generate-store-assets.mjs",
    "release-notes": "node scripts/generate-release-notes.mjs",
    "tag-version": "node ./set-version.js --tag",
    "check-eol": "node scripts/check-line-endings.mjs",
    "deploy": "npm run set-version && npm run icons && npm run release-notes && npm run tag-version && npm run check-eol && ng deploy"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/saira-stencil-one": "^5.3.0",
    "dexie": "^4.4.4",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "angular-cli-ghpages": "^3.1.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
